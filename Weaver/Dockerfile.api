FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY Weaver.sln .
COPY src/Weaver.Domain/Weaver.Domain.csproj src/Weaver.Domain/
COPY src/Weaver.Infrastructure/Weaver.Infrastructure.csproj src/Weaver.Infrastructure/
COPY src/Weaver.Scraping/Weaver.Scraping.csproj src/Weaver.Scraping/
COPY src/Weaver.Workflows/Weaver.Workflows.csproj src/Weaver.Workflows/
COPY src/Weaver.Api/Weaver.Api.csproj src/Weaver.Api/
COPY src/Weaver.Worker/Weaver.Worker.csproj src/Weaver.Worker/
RUN dotnet restore src/Weaver.Api/Weaver.Api.csproj
COPY src/ src/
RUN dotnet publish src/Weaver.Api/Weaver.Api.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=build /app .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8080/health || exit 1
ENTRYPOINT ["dotnet", "Weaver.Api.dll"]
